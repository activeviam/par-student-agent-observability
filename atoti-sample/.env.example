# Copy to `.env` and run `uv run --env-file .env atoti-sample`.

# --- Atoti ---
# License including the `ai-essentials` component (base64 key or path to the license file).
ATOTI_LICENSE=
# ATOTI_PORT=9090
# ATOTI_SERVER_SERVICE_NAME=atoti-sample-server

# --- Atoti Intelligence on Amazon Bedrock ---
# Atoti starts without AI when the two keys below are not set.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials (AWS SSO, assumed role...).
# AWS_SESSION_TOKEN=
# AWS_REGION=eu-west-3
# BEDROCK_MODEL=eu.anthropic.claude-sonnet-4-6

# --- OpenTelemetry (defaults target `docker-compose.yml` at the root of the repository) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=atoti-sample
# OTEL_METRIC_EXPORT_INTERVAL=10000
